"""
test_registration.py - Test suite for user registration.

Run ID: 2025-12-17-R2
Scenario: Successful user registration
Given: I am on the authentication page
When: I enter my email, fill personal info, enter password, submit form
Then: I should see my account page with welcome message
"""

import pytest
import time
from roles.new_user import NewUser
from pages.auth.registration_page import RegistrationPage
from resources.utilities import autologger


class TestRegistration:
    """
    Test suite for user registration.

    Uses AAA pattern:
    - Arrange: Create role with test data
    - Act: Call ONE workflow method
    - Assert: Use POM state-check method
    """

    @pytest.fixture(autouse=True)
    def setup(self, web_interface, config):
        """Setup test fixtures."""
        self.web = web_interface
        self.config = config
        self.base_url = config.get("url", config.get("base_url", ""))
        # POM for assertions
        self.registration_page = RegistrationPage(web_interface)

    @pytest.mark.auth
    @pytest.mark.registration
    @autologger.automation_logger("Test")
    def test_successful_user_registration(self):
        """
        Test that a new user can successfully register an account.

        AAA Pattern:
        1. Arrange - Create NewUser role with unique email
        2. Act - Call register() workflow method
        3. Assert - Verify account created via POM state-check
        """
        # Arrange - Generate unique email using timestamp
        timestamp = int(time.time())
        user_data = {
            "email": f"testuser_{timestamp}@example.com",
            "firstname": "Test",
            "lastname": "User",
            "password": "Test123!"
        }
        user = NewUser(self.web, user_data, self.base_url)

        # Act - ONE workflow call, NO return value
        user.register()

        # Assert - Via POM state-check method (NOT return value)
        assert self.registration_page.is_account_created(), \
            "User account should be created successfully"
