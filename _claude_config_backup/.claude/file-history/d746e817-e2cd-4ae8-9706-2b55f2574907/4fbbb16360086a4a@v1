async def _test_run_validation_suite(
    scenarios: List[str],
    content_maps: Optional[Dict[str, Dict[str, str]]] = None
) -> Dict[str, Any]:
    """
    Test wrapper for validation suite.

    Returns dict instead of MCP tool response for easier testing.
    """
    report = await _run_validation_suite(scenarios, content_maps)

    return {
        "report_id": report.report_id,
        "overall_status": report.overall_status,
        "total_scenarios": report.total_scenarios,
        "scenarios_passed": report.scenarios_passed,
        "scenarios_failed": report.scenarios_failed,
        "scenarios_skipped": report.scenarios_skipped,
        "total_dd_violations": report.total_dd_violations,
        "violations_by_severity": report.violations_by_severity,
        "scenario_results": [asdict(r) for r in report.scenario_results],
        "formatted_report": _format_report_summary(report)
    }


async def _test_run_scenario(
    scenario_id: str,
    content_map: Optional[Dict[str, str]] = None
) -> Dict[str, Any]:
    """
    Test wrapper for single scenario execution.
    """
    result = await _run_scenario(scenario_id, content_map)
    return asdict(result)


