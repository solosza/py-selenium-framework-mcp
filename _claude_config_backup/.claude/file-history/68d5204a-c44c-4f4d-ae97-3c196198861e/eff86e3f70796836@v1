assert result is True

# Role Layer (RegisteredUser)
def login(self):
    return self.auth_tasks.login(self.user_data["email"], self.user_data["password"])

# Task Layer (AuthTasks)
def login(self, email, password):
    self.login_page.enter_email(email).enter_passwd(password).click_submitlogin()
    return self.verify_login_success()

# Page Layer (LoginPage) - Fluent Interface
def enter_email(self, text: str):
    self.web.type_text(*self.EMAIL, text)
    return self  # Fluent chaining!
```

