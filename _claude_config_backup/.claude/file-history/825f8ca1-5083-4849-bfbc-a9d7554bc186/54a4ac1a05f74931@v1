"""
CheckoutPage - Multi-step checkout page object.

This page handles the checkout process steps:
- Step 02: Sign in (if not logged in)
- Step 03: Address selection
- Step 04: Shipping/delivery options
- Step 05: Payment selection
"""

import time
from selenium.webdriver.common.by import By
from interfaces.web_interface import WebInterface


class CheckoutPage:
    """Page Object for Checkout pages (Steps 02-05)."""

    def __init__(self, web: WebInterface):
        """
        Initialize CheckoutPage.

        Args:
            web: WebInterface instance
        """
        self.web = web

    # ==================== LOCATORS ====================

    # Common checkout elements
    CHECKOUT_STEP_HEADING = (By.CSS_SELECTOR, "h1.page-heading")
    STEP_NUMBER = (By.CSS_SELECTOR, ".step-num")

    # Step 03: Address
    DELIVERY_ADDRESS = (By.CSS_SELECTOR, "#address_delivery")
    BILLING_ADDRESS = (By.CSS_SELECTOR, "#address_invoice")
    ADDRESS_PROCEED_BTN = (By.CSS_SELECTOR, "button[name='processAddress']")
    ADD_NEW_ADDRESS_LINK = (By.CSS_SELECTOR, "a[title='Add a new address']")

    # Step 04: Shipping/Delivery
    DELIVERY_OPTION = (By.CSS_SELECTOR, "#delivery_option_4_0")
    TERMS_CHECKBOX = (By.CSS_SELECTOR, "#cgv")
    SHIPPING_PROCEED_BTN = (By.CSS_SELECTOR, "button[name='processCarrier']")
    SHIPPING_COST = (By.CSS_SELECTOR, "#total_shipping")

    # Step 05: Payment
    PAY_BY_BANK_WIRE = (By.CSS_SELECTOR, ".bankwire")
    PAY_BY_CHECK = (By.CSS_SELECTOR, ".cheque")
    PAYMENT_CONFIRM_BTN = (By.CSS_SELECTOR, "#cart_navigation button")
    ORDER_TOTAL = (By.CSS_SELECTOR, "#total_price")

    # Error handling
    TERMS_ERROR = (By.CSS_SELECTOR, ".fancybox-error")
    CLOSE_ERROR_BTN = (By.CSS_SELECTOR, "a.fancybox-close")

    # ==================== PAGE METHODS ====================

    def is_page_loaded(self) -> bool:
        """
        Verify checkout page is loaded.

        Returns:
            True if checkout heading is visible
        """
        return self.web.is_element_displayed(*self.CHECKOUT_STEP_HEADING, timeout=10)

    def get_current_step(self) -> str:
        """
        Get current checkout step from page heading.

        Returns:
            Step heading text
        """
        element = self.web.find_element(*self.CHECKOUT_STEP_HEADING)
        return element.text.strip()

    # ==================== STEP 03: ADDRESS METHODS ====================

    def is_address_step(self) -> bool:
        """
        Check if on address step.

        Returns:
            True if on address selection step
        """
        return self.web.is_element_displayed(*self.DELIVERY_ADDRESS, timeout=5)

    def click_proceed_address(self) -> "CheckoutPage":
        """
        Click proceed button on address step.

        Returns:
            self for method chaining
        """
        self.web.click(*self.ADDRESS_PROCEED_BTN)
        return self

    # ==================== STEP 04: SHIPPING METHODS ====================

    def is_shipping_step(self) -> bool:
        """
        Check if on shipping step.

        Returns:
            True if on shipping selection step
        """
        return self.web.is_element_displayed(*self.TERMS_CHECKBOX, timeout=5)

    def accept_terms(self) -> "CheckoutPage":
        """
        Check the terms and conditions checkbox.

        Returns:
            self for method chaining
        """
        checkbox = self.web.find_element(*self.TERMS_CHECKBOX)
        if not checkbox.is_selected():
            self.web.click(*self.TERMS_CHECKBOX)
        return self

    def click_proceed_shipping(self) -> "CheckoutPage":
        """
        Click proceed button on shipping step.

        Returns:
            self for method chaining
        """
        self.web.click(*self.SHIPPING_PROCEED_BTN)
        return self

    def close_terms_error(self) -> "CheckoutPage":
        """
        Close terms error popup if displayed.

        Returns:
            self for method chaining
        """
        if self.web.is_element_displayed(*self.CLOSE_ERROR_BTN, timeout=2):
            self.web.click(*self.CLOSE_ERROR_BTN)
            time.sleep(0.5)
        return self

    # ==================== STEP 05: PAYMENT METHODS ====================

    def is_payment_step(self) -> bool:
        """
        Check if on payment step.

        Returns:
            True if on payment selection step
        """
        return self.web.is_element_displayed(*self.PAY_BY_BANK_WIRE, timeout=5)

    def select_pay_by_bank_wire(self) -> "CheckoutPage":
        """
        Select bank wire payment method.

        Returns:
            self for method chaining
        """
        self.web.click(*self.PAY_BY_BANK_WIRE)
        return self

    def select_pay_by_check(self) -> "CheckoutPage":
        """
        Select check payment method.

        Returns:
            self for method chaining
        """
        self.web.click(*self.PAY_BY_CHECK)
        return self

    def click_confirm_order(self) -> "CheckoutPage":
        """
        Click confirm order button.

        Returns:
            self for method chaining
        """
        self.web.click(*self.PAYMENT_CONFIRM_BTN)
        return self

    def get_order_total(self) -> str:
        """
        Get order total from checkout.

        Returns:
            Order total as string
        """
        element = self.web.find_element(*self.ORDER_TOTAL)
        return element.text.strip()
